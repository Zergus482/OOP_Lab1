<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_1"
        xmlns:views="clr-namespace:Lab_1.View"
        
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        x:Name="MainWindow1"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl>
            <TabItem Header="Привязка по умолчанию">
                <views:Window1 />
            </TabItem>
            <TabItem Header="Двухсторонняя привязка">
                <views:Page2 />
            </TabItem>
            <TabItem Header="Одноразовая привязка">
                <Grid Background="#FFE5E5E5" />
            </TabItem>
            <TabItem Header="Односторонние привязки">
                <Grid Background="#FFE5E5E5" />
            </TabItem>
            <TabItem Header="Триггеры">
                <Grid Background="#FFE5E5E5" />
            </TabItem>
        </TabControl>

    </Grid>
</Window>
