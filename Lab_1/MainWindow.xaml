<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_1"
        xmlns:views="clr-namespace:Lab_1.Views"
        mc:Ignorable="d"
        Title="{DynamicResource MainWindow_Title}"
        Height="520"
        Width="900"
        MinHeight="400"
        MinWidth="700"
        x:Name="MainWindow1"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0F4F8" Offset="0"/>
                <GradientStop Color="#E2E8F0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель выбора языка -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="16,8,16,0">
            <TextBlock Text="Язык:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox Width="120"
                      SelectedIndex="0"
                      SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Tag="ru" Content="Русский"/>
                <ComboBoxItem Tag="en" Content="English"/>
            </ComboBox>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="{DynamicResource Tab_DefaultBinding}">
                <views:Window1 />
            </TabItem>
            <TabItem Header="{DynamicResource Tab_TwoWay}">
                <views:Page2 />
            </TabItem>
            <TabItem Header="{DynamicResource Tab_OneTime}">
                <views:OneTime />
            </TabItem>
            <TabItem Header="{DynamicResource Tab_OneWay}">
                <views:OneWay />
            </TabItem>
            <TabItem Header="{DynamicResource Tab_Triggers}">
                <views:Triggers />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
