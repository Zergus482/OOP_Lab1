  <sys:String x:Key="Triggers_Label_Event_Description">Trigger fires when an event occurs:</sys:String>
  <sys:String x:Key="Triggers_Button_Event">Click for animation</sys:String>
  <sys:String x:Key="Triggers_Label_Event_Info">Animation starts on Click, MouseEnter and MouseLeave</sys:String>

