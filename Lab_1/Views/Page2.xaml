<UserControl x:Class="Lab_1.Views.Page2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:Lab_1.Views"
             xmlns:viewModels="clr-namespace:Lab_1.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:Page2 />
    </UserControl.DataContext>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Двусторонняя привязка"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="Прямая двухсторонняя привязка между элементами"
                          Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <TextBlock Text="Два TextBox связаны двухсторонней привязкой:"
                                   Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Name="TwoWayTextBox1"
                                     Text="Введите текст"
                                     Margin="0,0,10,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Text, ElementName=TwoWayTextBox1, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="Slider и TextBox связаны двухсторонней привязкой:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider Grid.Row="0"
                                    Name="TwoWaySlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="50"
                                    Margin="0,0,0,10" />
                            <TextBox Grid.Row="1"
                                     Text="{Binding Value, ElementName=TwoWaySlider, Mode=TwoWay, StringFormat='{}{0:F1}'}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Двухсторонняя привязка через ViewModel">
                    <StackPanel Margin="10">
                        <TextBlock Text="Имя (изменения синхронизируются):"
                                   Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Name, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}" />
                        </Grid>

                        <TextBlock Text="Фамилия:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Surname, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Surname}" />
                        </Grid>

                        <TextBlock Text="Возраст:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Age, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Age, StringFormat='{}{0} лет'}" />
                        </Grid>

                        <TextBlock Text="Email:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Email, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Email}" />
                        </Grid>

                        <TextBlock Text="Slider (двухсторонняя привязка):"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider Grid.Row="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding SliderValue, Mode=TwoWay}"
                                    Margin="0,0,0,10" />
                            <TextBox Grid.Row="1"
                                     Text="{Binding SliderValue, Mode=TwoWay, StringFormat='{}{0:F1}'}" />
                        </Grid>

                        <TextBlock Text="Полная информация (вычисляемое свойство):"
                                   Margin="0,15,0,5" />
                        <TextBlock Text="{Binding FullInfo}"
                                   FontWeight="Bold"
                                   Padding="5"
                                   Background="LightBlue" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
