<UserControl x:Class="Lab_1.Views.Triggers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Lab_1.ViewModels"
             mc:Ignorable="d">
    <Grid Margin="16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Tr Page_Triggers_Title}"
                   Style="{StaticResource PageTitle}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="{Tr Triggers_Group_Property_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Tr Triggers_Label_Property_Description}"
                                   Style="{StaticResource SectionLabel}" />
                        <Button Name="PropertyTriggerButton"
                                Content="{Tr Triggers_Button_Hover}"
                                Width="200"
                                Height="40">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="LightBlue" />
                                    <Setter Property="Foreground"
                                            Value="Black" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="DarkBlue" />
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Red" />
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Tr Triggers_Label_Property_Info}"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr Triggers_Group_Data_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Tr Triggers_Label_Data_Description}"
                                   Style="{StaticResource SectionLabel}" />
                        <CheckBox Name="DataTriggerCheckBox"
                                  Content="{Tr Triggers_CheckBox_Enable}" />
                        <Border Name="DataTriggerBorder"
                                Background="LightGray"
                                Padding="10"
                                Margin="0,10,0,0">
                            <TextBlock Text="{Tr Triggers_Label_Data_BlockText}" />
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DataTriggerCheckBox}"
                                                     Value="True">
                                            <Setter Property="Background"
                                                    Value="Green" />
                                            <Setter Property="BorderBrush"
                                                    Value="Green" />
                                            <Setter Property="BorderThickness"
                                                    Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Tr Triggers_Label_Data_Info}"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr Triggers_Group_MultiData_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Tr Triggers_Label_MultiData_Description}"
                                   Style="{StaticResource SectionLabel}" />
                        <CheckBox Name="MultiTriggerCheckBox1"
                                  Content="{Tr Triggers_CheckBox_Cond1}" />
                        <CheckBox Name="MultiTriggerCheckBox2"
                                  Content="{Tr Triggers_CheckBox_Cond2}"
                                  Margin="0,5,0,0" />
                        <Button Name="MultiTriggerButton"
                                Content="{Tr Triggers_Button_Multi}"
                                Width="400"
                                Height="40"
                                Margin="0,10,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Gray" />
                                    <Setter Property="IsEnabled"
                                            Value="False" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=MultiTriggerCheckBox1}"
                                                           Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=MultiTriggerCheckBox2}"
                                                           Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled"
                                                    Value="True" />
                                            <Setter Property="Background"
                                                    Value="Green" />
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Tr Triggers_Label_MultiData_Info}"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr Triggers_Group_Event_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Tr Triggers_Label_Event_Description}"
                                   Style="{StaticResource SectionLabel}" />
                        <Button Name="EventTriggerButton"
                                Content="{Tr Triggers_Button_Event}"
                                Width="200"
                                Height="40"
                                Background="LightBlue">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EventTriggerButton"
                                                             Storyboard.TargetProperty="Width"
                                                             To="300"
                                                             Duration="0:0:0.5" />
                                            <ColorAnimation Storyboard.TargetName="EventTriggerButton"
                                                            Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                            To="Orange"
                                                            Duration="0:0:0.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Button.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EventTriggerButton"
                                                             Storyboard.TargetProperty="FontSize"
                                                             To="16"
                                                             Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Button.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EventTriggerButton"
                                                             Storyboard.TargetProperty="FontSize"
                                                             To="14"
                                                             Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                        <TextBlock Text="{Tr Triggers_Label_Event_Info}"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr Triggers_Group_Compare_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Tr Triggers_Label_Compare_Property}"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Tr Triggers_Label_Compare_Data}"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Tr Triggers_Label_Compare_MultiData}"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Tr Triggers_Label_Compare_Event}"
                                   Style="{StaticResource SectionLabel}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
