<UserControl x:Class="Lab_1.Views.Triggers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Lab_1.ViewModels"
             mc:Ignorable="d">
    <Grid Margin="16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Триггеры (Triggers)"
                   Style="{StaticResource PageTitle}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="Property Trigger (Триггер свойства)">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Изменение свойства элемента вызывает триггер:"
                                   Style="{StaticResource SectionLabel}" />
                        <Button Name="PropertyTriggerButton"
                                Content="Наведите курсор"
                                Width="200"
                                Height="40">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="LightBlue" />
                                    <Setter Property="Foreground"
                                            Value="Black" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="DarkBlue" />
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Red" />
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="Триггер срабатывает при IsMouseOver=True и IsPressed=True"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Data Trigger (Триггер данных)">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Триггер срабатывает при изменении привязанного свойства:"
                                   Style="{StaticResource SectionLabel}" />
                        <CheckBox Name="DataTriggerCheckBox"
                                  Content="Включить триггер" />
                        <Border Name="DataTriggerBorder"
                                Background="LightGray"
                                Padding="10"
                                Margin="0,10,0,0">
                            <TextBlock Text="Этот блок изменит цвет при установке флажка" />
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DataTriggerCheckBox}"
                                                     Value="True">
                                            <Setter Property="Background"
                                                    Value="Green" />
                                            <Setter Property="BorderBrush"
                                                    Value="Green" />
                                            <Setter Property="BorderThickness"
                                                    Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="Триггер срабатывает при IsChecked=True"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Multi Data Trigger (Множественный триггер данных)">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Триггер срабатывает только при выполнении всех условий (использует привязки):"
                                   Style="{StaticResource SectionLabel}" />
                        <CheckBox Name="MultiTriggerCheckBox1"
                                  Content="Условие 1" />
                        <CheckBox Name="MultiTriggerCheckBox2"
                                  Content="Условие 2"
                                  Margin="0,5,0,0" />
                        <Button Name="MultiTriggerButton"
                                Content="Кнопка активируется при выполнении обоих условий"
                                Width="400"
                                Height="40"
                                Margin="0,10,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Gray" />
                                    <Setter Property="IsEnabled"
                                            Value="False" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=MultiTriggerCheckBox1}"
                                                           Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=MultiTriggerCheckBox2}"
                                                           Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled"
                                                    Value="True" />
                                            <Setter Property="Background"
                                                    Value="Green" />
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="Кнопка активируется только когда оба флажка установлены"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Event Trigger (Триггер события)">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Триггер срабатывает при возникновении события:"
                                   Style="{StaticResource SectionLabel}" />
                        <Button Name="EventTriggerButton"
                                Content="Нажмите для анимации"
                                Width="200"
                                Height="40"
                                Background="LightBlue">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EventTriggerButton"
                                                             Storyboard.TargetProperty="Width"
                                                             To="300"
                                                             Duration="0:0:0.5" />
                                            <ColorAnimation Storyboard.TargetName="EventTriggerButton"
                                                            Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                            To="Orange"
                                                            Duration="0:0:0.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Button.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EventTriggerButton"
                                                             Storyboard.TargetProperty="FontSize"
                                                             To="16"
                                                             Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Button.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EventTriggerButton"
                                                             Storyboard.TargetProperty="FontSize"
                                                             To="14"
                                                             Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                        <TextBlock Text="Анимация запускается при Click, MouseEnter и MouseLeave"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Сравнение типов триггеров">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Property Trigger: реагирует на изменение свойств элемента"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Data Trigger: реагирует на изменение привязанных данных"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Multi Data Trigger: требует выполнения нескольких условий одновременно (работает с привязками)"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Event Trigger: реагирует на события и может запускать анимации"
                                   Style="{StaticResource SectionLabel}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
