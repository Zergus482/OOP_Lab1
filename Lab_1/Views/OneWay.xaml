<UserControl x:Class="Lab_1.Views.OneWay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lab_1.Views"
             xmlns:viewModels="clr-namespace:Lab_1.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:OneWay />
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Односторонние привязки (OneWay Binding)"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="Прямая односторонняя привязка (от источника к цели)"
                          Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <TextBlock Text="Slider → TextBlock (изменения Slider обновляют TextBlock):"
                                   Margin="0,0,0,5" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider Grid.Row="0"
                                    Name="OneWaySlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="30"
                                    Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Value, ElementName=OneWaySlider, Mode=OneWay, StringFormat='Значение: {0:F1}'}" />
                        </Grid>

                        <TextBlock Text="TextBox → TextBlock (изменения TextBox обновляют TextBlock):"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Name="OneWayTextBox"
                                     Text="Введите текст"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text, ElementName=OneWayTextBox, Mode=OneWay}" />
                        </Grid>

                        <TextBlock Text="Изменения в TextBlock не влияют на источник"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Односторонняя привязка через ViewModel">
                    <StackPanel Margin="10">
                        <TextBlock Text="Исходный текст (изменения обновляют отображение):"
                                   Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SourceText, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SourceText, Mode=OneWay}"
                                       Background="LightBlue"
                                       Padding="5" />
                        </Grid>

                        <TextBlock Text="Исходное число:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SourceNumber, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SourceNumber, Mode=OneWay, StringFormat='Число: {0}'}"
                                       Background="LightBlue"
                                       Padding="5" />
                        </Grid>

                        <TextBlock Text="Вычисляемое значение (обновляется автоматически):"
                                   Margin="0,15,0,5" />
                        <TextBlock Text="{Binding ComputedValue, Mode=OneWay}"
                                   Background="LightGreen"
                                   Padding="5"
                                   FontWeight="Bold" />

                        <TextBlock Text="Комбинированное отображение:"
                                   Margin="0,15,0,5" />
                        <TextBlock Text="{Binding DisplayText, Mode=OneWay}"
                                   Background="LightCoral"
                                   Padding="5"
                                   FontWeight="Bold" />

                        <TextBlock Text="Изменения в источниках автоматически обновляют все элементы с OneWay привязкой"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,15,0,0" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
