<UserControl x:Class="Lab_1.Views.OneWay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lab_1.Views"
             xmlns:viewModels="clr-namespace:Lab_1.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:OneWay />
    </UserControl.DataContext>
    <Grid Margin="16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Tr Page_OneWay_Title}"
                   Style="{StaticResource PageTitle}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="{Tr OneWay_Group_Direct_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Tr OneWay_Label_SliderToTextBlock}"
                                   Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider Grid.Row="0"
                                    Name="OneWaySlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="30"
                                    Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Value, ElementName=OneWaySlider, Mode=OneWay, StringFormat='Значение: {0:F1}'}" />
                        </Grid>

                        <TextBlock Text="{Tr OneWay_Label_TextBoxToTextBlock}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Name="OneWayTextBox"
                                     Text="Введите текст"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text, ElementName=OneWayTextBox, Mode=OneWay}" />
                        </Grid>

                        <TextBlock Text="{Tr OneWay_Label_TextDoesNotAffectSource}"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr OneWay_Group_ViewModel_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Tr OneWay_Label_SourceText}"
                                   Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SourceText, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SourceText, Mode=OneWay}"
                                       Background="#E3F2FD"
                                       Padding="10,8"
                                       Foreground="#1565C0" />
                        </Grid>

                        <TextBlock Text="{Tr OneWay_Label_SourceNumber}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SourceNumber, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SourceNumber, Mode=OneWay, StringFormat='Число: {0}'}"
                                       Background="#E3F2FD"
                                       Padding="10,8"
                                       Foreground="#1565C0" />
                        </Grid>

                        <TextBlock Text="{Tr OneWay_Label_ComputedValue}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{Binding ComputedValue, Mode=OneWay}"
                                   Background="#E8F5E9"
                                   Padding="10,8"
                                   FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="{Tr OneWay_Label_DisplayText}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{Binding DisplayText, Mode=OneWay}"
                                   Background="#FFEBEE"
                                   Padding="10,8"
                                   FontWeight="Bold"
                                   Foreground="#C62828"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="{Tr OneWay_Label_SourcesUpdateTargets}"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,15,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
