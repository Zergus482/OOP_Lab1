<UserControl x:Class="Lab_1.Views.OneTime"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Lab_1.ViewModels"
             xmlns:views="clr-namespace:Lab_1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:OneTime />
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Одноразовая привязка (OneTime Binding)"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="Прямая одноразовая привязка к элементам"
                          Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <TextBlock Text="Одноразовая привязка (значение загружается один раз и не обновляется):"
                                   Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Name="OneTimeTextBox"
                                     Text="Начальное значение"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text, ElementName=OneTimeTextBox, Mode=OneTime}" />
                        </Grid>

                        <TextBlock Text="Изменение исходного TextBox не обновит TextBlock выше"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Одноразовая привязка через ViewModel">
                    <StackPanel Margin="10">
                        <TextBlock Text="Начальное значение (загружается один раз):"
                                   Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding InitialValue, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding InitialValue, Mode=OneTime}"
                                       Background="LightYellow"
                                       Padding="5" />
                        </Grid>

                        <TextBlock Text="Начальное число:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding InitialNumber, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding InitialNumber, Mode=OneTime, StringFormat='Число: {0}'}"
                                       Background="LightYellow"
                                       Padding="5" />
                        </Grid>

                        <TextBlock Text="Статический текст (OneTime):"
                                   Margin="0,15,0,5" />
                        <TextBlock Text="{Binding StaticText, Mode=OneTime}"
                                   Background="LightGreen"
                                   Padding="5"
                                   FontWeight="Bold" />

                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
