<UserControl x:Class="Lab_1.Views.OneTime"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Lab_1.ViewModels"
             xmlns:views="clr-namespace:Lab_1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:OneTime />
    </UserControl.DataContext>
    <Grid Margin="16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Tr Page_OneTime_Title}"
                   Style="{StaticResource PageTitle}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="{Tr OneTime_Group_Direct_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Tr OneTime_Label_DirectDescription}"
                                   Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Name="OneTimeTextBox"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text, ElementName=OneTimeTextBox, Mode=OneTime}" />
                        </Grid>

                        <TextBlock Text="{Tr OneTime_Label_TextDoesNotUpdate}"
                                   FontStyle="Italic"
                                   Foreground="#5A6C7D"
                                   Margin="0,10,0,0"
                                   FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr OneTime_Group_ViewModel_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Tr OneTime_Label_InitialValue}"
                                   Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding InitialValue, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding InitialValue, Mode=OneTime}"
                                       Background="#FFFDE7"
                                       Padding="10,8"
                                       Foreground="#5D4037" />
                        </Grid>

                        <TextBlock Text="{Tr OneTime_Label_InitialNumber}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding InitialNumber, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding InitialNumber, Mode=OneTime, StringFormat='Число: {0}'}"
                                       Background="#FFFDE7"
                                       Padding="10,8"
                                       Foreground="#5D4037" />
                        </Grid>

                        <TextBlock Text="{Tr OneTime_Label_StaticText}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{Binding StaticText, Mode=OneTime}"
                                   Background="#E8F5E9"
                                   Padding="10,8"
                                   FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   Margin="0,6,0,0" />

                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
