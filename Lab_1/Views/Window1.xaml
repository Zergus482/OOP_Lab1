<UserControl x:Class="Lab_1.Views.Window1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Lab_1.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:First_page />
    </UserControl.DataContext>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Привязка по умолчанию (Default Binding)"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="Прямая привязка к элементам интерфейса"
                          Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <TextBlock Text="Привязка TextBox к TextBlock (по умолчанию - TwoWay для TextBox):"
                                   Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Name="DirectTextBox"
                                     Text="Введите текст"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text, ElementName=DirectTextBox}" />
                        </Grid>

                        <TextBlock Text="Привязка CheckBox к TextBlock:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Name="DirectCheckBox"
                                      Content="Выбрано"
                                      IsChecked="True"
                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding IsChecked, ElementName=DirectCheckBox}" />
                        </Grid>

                        <TextBlock Text="Привязка Slider к TextBlock:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Name="DirectSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="50"
                                    Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value, ElementName=DirectSlider, StringFormat='Значение: {0:F1}'}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Привязка через ViewModel">
                    <StackPanel Margin="10">
                        <TextBlock Text="Привязка TextBox к ViewModel (по умолчанию - TwoWay):"
                                   Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding TextValue}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TextValue}" />
                        </Grid>

                        <TextBlock Text="Привязка NumericUpDown (TextBox) к ViewModel:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NumberValue}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding NumberValue, StringFormat='Число: {0}'}" />
                        </Grid>

                        <TextBlock Text="Привязка DatePicker к ViewModel:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding DateValue}"
                                        Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DateValue, StringFormat='Дата: {0:dd.MM.yyyy}'}" />
                        </Grid>

                        <TextBlock Text="Привязка CheckBox к ViewModel:"
                                   Margin="0,15,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Content="Выбрано"
                                      IsChecked="{Binding IsChecked}"
                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding IsChecked, StringFormat='Состояние: {0}'}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

