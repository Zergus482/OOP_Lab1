<UserControl x:Class="Lab_1.Views.Window1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Lab_1.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:First_page />
    </UserControl.DataContext>

    <Grid Margin="16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Page_DefaultBinding_Title}"
                   Style="{StaticResource PageTitle}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="{DynamicResource Default_Group_DirectBinding_Header}"
                          Margin="0,0,0,20">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Default_Label_TextBoxToTextBlock}"
                                   Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Name="DirectTextBox"
                                     Text="{DynamicResource Default_TextBox_EnterText}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text, ElementName=DirectTextBox}" />
                        </Grid>

                        <TextBlock Text="{DynamicResource Default_Label_CheckBoxToTextBlock}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Name="DirectCheckBox"
                                      Content="{DynamicResource Default_CheckBox_Content_Selected}"
                                      IsChecked="True"
                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding IsChecked, ElementName=DirectCheckBox}" />
                        </Grid>

                        <TextBlock Text="{DynamicResource Default_Label_SliderToTextBlock}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Name="DirectSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="50"
                                    Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value, ElementName=DirectSlider, StringFormat='Значение: {0:F1}'}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource Default_Label_ViewModel_Header}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Default_Label_TextBox_ViewModel}"
                                   Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding TextValue}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TextValue}" />
                        </Grid>

                        <TextBlock Text="{DynamicResource Default_Label_Numeric_ViewModel}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NumberValue}"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding NumberValue, StringFormat='Число: {0}'}" />
                        </Grid>

                        <TextBlock Text="{DynamicResource Default_Label_Date_ViewModel}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding DateValue}"
                                        Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DateValue, StringFormat='Дата: {0:dd.MM.yyyy}'}" />
                        </Grid>

                        <TextBlock Text="{DynamicResource Default_Label_CheckBox_ViewModel}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Content="{DynamicResource Default_CheckBox_Content_Selected}"
                                      IsChecked="{Binding IsChecked}"
                                      Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding IsChecked}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

